# Qwen2.5-VL-7B-Instruct vLLM endpoint
VLMEVAL_TARGET_BASE_URL=http://127.0.0.1:8002/v1
VLMEVAL_TARGET_API_KEY=local-no-key
VLMEVAL_TARGET_MODEL=qwen2.5-vl-7b-instruct

# Local-only source Parquet files. Automatic dataset download is disabled.
VLMEVAL_CHARTQA_TEST_PATH=/opt/VLMEvalKit/data/ChartQA_TEST/test-00000-of-00001.parquet
VLMEVAL_CHARTQAPRO_PATH=/opt/VLMEvalKit/data/ChartQAPro/test-00000-of-00001.parquet
LMUData=/opt/VLMEvalKit/LMUData

VLMEVAL_OUTPUT_DIR=/var/lib/vlmevalkit/chartqa-tasks
VLMEVAL_DATABASE_URL=sqlite:////var/lib/vlmevalkit/chartqa-tasks.db
VLMEVAL_API_NPROC=8
VLMEVAL_REQUEST_TIMEOUT=1800
