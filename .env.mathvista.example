# Target Qwen2.5-VL-7B vLLM endpoint
VLMEVAL_TARGET_BASE_URL=http://127.0.0.1:8001/v1
VLMEVAL_TARGET_API_KEY=local-no-key
VLMEVAL_TARGET_MODEL=qwen2.5-vl-7b-instruct

# Primary task-level judge
VLMEVAL_PRIMARY_JUDGE_BASE_URL=http://127.0.0.1:8080/v1
VLMEVAL_PRIMARY_JUDGE_API_KEY=local-no-key
VLMEVAL_PRIMARY_JUDGE_MODEL=qwen3.8-flash

# Backup task-level judge. Leave URL/key empty until the service is configured.
VLMEVAL_BACKUP_JUDGE_BASE_URL=
VLMEVAL_BACKUP_JUDGE_API_KEY=
VLMEVAL_BACKUP_JUDGE_MODEL=gpt-5.5

VLMEVAL_OUTPUT_DIR=/var/lib/vlmevalkit/tasks
VLMEVAL_DATABASE_URL=sqlite:////var/lib/vlmevalkit/tasks.db
VLMEVAL_API_NPROC=8
VLMEVAL_JUDGE_API_NPROC=8
VLMEVAL_REQUEST_TIMEOUT=1800
VLMEVAL_JUDGE_TIMEOUT=600
