[Unit]
Description=Qwen 3.8 Flash primary MathVista judge
After=network-online.target

[Service]
Type=simple
User=gpu
EnvironmentFile=/etc/safetyllm/models.env
ExecStart=/opt/vllm/bin/vllm serve /models/Qwen3.8-Flash --served-model-name qwen3.8-flash --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
